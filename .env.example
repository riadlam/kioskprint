APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Change this LAN URL in one place for the website (QR targets, absolute links).
# Keep Flutter lib/config/app_config.dart apiBaseUrl in sync.
APP_URL=http://192.168.1.9:8000

# Operator login for https://metbati.com/admin. Leave either blank to keep it locked.
ADMIN_EMAIL=
ADMIN_PASSWORD=

PRINT_PRICE_PER_PAGE=20
PRINT_SIMULATE_MONNAYEUR=false
# Shared with esp32-coin-test/coin_agent.env. The coin agent sends this header.
KIOSK_COIN_TOKEN=change-me
# When true, selecting Algérie Poste marks the job paid and prints on the kiosk (debug).
PRINT_EMULATE_POSTE_PAID=true
PRINT_DRIVER=windows
# socket pushes each paid sheet to the mini PC over the live websocket.
# Set PRINT_DRIVER=remote and this address so the VPS sends each page to the mini PC.
KIOSK_PRINT_URL=
PRINT_PRINTER_NAME="Canon LBP6030/6040/6018L"
# Portable SumatraPDF used for silent printing. Defaults to tools/sumatra/SumatraPDF-3.5.2-64.exe
# PRINT_SUMATRA_PATH=
PRINT_PAGE_TIMEOUT=90

# Telegram order updates. The token stays on the server. Open @metbati_bot and send /start once.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Keep REVERB_HOST / Flutter AppConfig in sync with APP_URL host.
REVERB_APP_ID=metbati
REVERB_APP_KEY=metbati-kiosk-key
REVERB_APP_SECRET=metbati-kiosk-secret
REVERB_HOST=192.168.1.9
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

VITE_GENIUS_SCAN_LICENSE_KEY=
